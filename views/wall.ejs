<%- include('partials/head', { title: 'Live wall · The Complaints Department' }) %>
<body class="admin">
  <main class="wall">
    <header class="wall-head">
      <h1>The Complaints Department</h1>
      <span class="livedot" id="livedot"><i></i> <span id="livetext">connecting</span></span>
      <div class="counts">
        <div>
          <div class="v" data-stat="tickets"><%= stats.tickets %></div>
          <div class="k">Tickets filed</div>
        </div>
        <div>
          <div class="v" data-stat="processing"><%= stats.processing %></div>
          <div class="k">In flight</div>
        </div>
        <div>
          <div class="v" id="sessions-total">—</div>
          <div class="k">MARS sessions</div>
        </div>
      </div>
    </header>

    <div class="cards" id="cards">
      <% if (!recent.length) { %>
        <div class="empty" id="empty" style="grid-column:1/-1">
          Waiting for the first grievance.
        </div>
      <% } %>
      <% recent.forEach(t => { %>
        <%- include('partials/card', { t }) %>
      <% }) %>
    </div>
  </main>

  <script>window.WALL_MODE = true;</script>
  <script src="/dashboard.js"></script>
</body>
</html>
