<%- include('partials/head', { title: 'Intake · Complaints Operations' }) %>
<body class="admin">
  <%- include('partials/nav', { active: 'complaints' }) %>

  <div class="wrap">
    <h2 class="section">Raw intake</h2>

    <form class="filters" method="get" action="/admin/complaints">
      <select name="status">
        <option value="">All statuses</option>
        <% ['pending', 'processing', 'ticketed', 'failed'].forEach(s => { %>
          <option value="<%= s %>" <%= status === s ? 'selected' : '' %>><%= s %></option>
        <% }) %>
      </select>
      <button type="submit">Filter</button>
      <a class="btn btn-secondary" href="/admin/complaints">Reset</a>
    </form>

    <table class="grid">
      <thead>
        <tr>
          <th>#</th>
          <th>Complaint</th>
          <th>Status</th>
          <th>Session</th>
          <th>Error</th>
          <th>Submitted</th>
        </tr>
      </thead>
      <tbody>
        <% if (!complaints.length) { %>
          <tr><td colspan="6" class="muted" style="padding:28px;text-align:center">Nothing yet.</td></tr>
        <% } %>
        <% complaints.forEach(c => { %>
          <tr>
            <td class="mono muted"><%= c.id %></td>
            <td style="max-width:460px">“<%= c.body %>”</td>
            <td>
              <span class="chip" style="<%= c.status === 'failed' ? 'background:#3f1d1d;color:#fca5a5' : (c.status === 'ticketed' ? 'background:#14342a;color:#6ee7b7' : '') %>">
                <%= c.status %>
              </span>
            </td>
            <td class="mono muted" style="font-size:11px"><%= c.session_id ? String(c.session_id).slice(0, 8) : '—' %></td>
            <td class="muted" style="font-size:12px;max-width:260px"><%= c.error || '' %></td>
            <td class="mono muted" style="font-size:11.5px;white-space:nowrap">
              <%= new Date(c.submitted_at).toLocaleString() %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</body>
</html>
