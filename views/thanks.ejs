<%- include('partials/head', { title: 'Grievance received' }) %>
<body>
  <main class="intake">
    <div class="intake-card">
      <div class="receipt">
        <div class="tick">✓</div>
        <h1>Your grievance has been received.</h1>
        <p>
          It is being triaged against the standard schema and will be assigned a component,
          a severity, an owner and a service-level objective.
        </p>
        <p class="muted" style="font-size:13.5px">
          You will not be contacted. There is no status page.
        </p>
        <% if (id) { %>
          <p class="ref">Reference CD-<%= String(id).padStart(6, '0') %></p>
        <% } %>
        <p style="margin-top:22px">
          <a class="btn btn-secondary" href="/">File another</a>
        </p>
      </div>
    </div>
  </main>
</body>
</html>
