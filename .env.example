# ─────────────────────────────────────────────────────────────────────────────
# The Complaints Department — configuration
#
#   cp .env.example .env   and fill in the marked values.
#
# DEPLOY needs: DIGITALOCEAN_ACCESS_TOKEN, GITHUB_REPO, ADMIN_PASSWORD.
# Then `./scripts/link-local.sh > .env.local` to run the UI locally against
# the cluster you just deployed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Password for the /admin dashboard. Change it.
ADMIN_PASSWORD=complaints

# Signs the admin session cookie. Any long random string.
# Generate: openssl rand -hex 32
SESSION_SECRET=dev-only-change-me

# ── Database ─────────────────────────────────────────────────────────────────
# DigitalOcean Managed Postgres, in every environment — there is no local
# database. deploy.sh binds this automatically on App Platform.
#
# To run the UI locally against the deployed cluster, don't set this by hand:
#
#   ./scripts/link-local.sh > .env.local
#
# which writes DATABASE_URL and the cluster CA into .env.local (it overrides
# .env). Until you have deployed once, there is nothing to point at.
# DATABASE_URL=postgresql://user:pass@host:25060/complaints?sslmode=require

# ── Harness Runtime ──────────────────────────────────────────────────────────
# Every complaint fires this webhook, and a fresh microVM writes the ticket.
# There is no in-process alternative: the agent's instructions live in
# agents/complaint-prompt.txt and that is the only copy of them.
#
# Written for you by `./scripts/link-local.sh > .env.local` after a deploy.
# MARS_WEBHOOK_URL=
# MARS_WEBHOOK_SECRET=
# MARS_TICKET_TABLE=tickets

# ── DigitalOcean serverless inference ────────────────────────────────────────
# All model calls go through DigitalOcean's inference service, which speaks the
# Anthropic Messages API. Used by INGEST_MODE=local and by the MARS agent.
#
# INFERENCE_API_KEY: a DigitalOcean model access key, or a personal access
# token with ALL scopes granted. Falls back to DIGITALOCEAN_ACCESS_TOKEN.
INFERENCE_API_KEY=
INFERENCE_BASE_URL=https://inference.do-ai.run

# A DigitalOcean model slug, NOT an Anthropic model id.
#   doctl serverless-inference models list
# anthropic-claude-opus-5     best writing, ~4s per ticket
# anthropic-claude-haiku-4.5  ~3x faster, noticeably blander
INFERENCE_MODEL=qwen3.8-max

# ── Deploy-time only (read by deploy.sh / destroy.sh, not by the app) ───────

# Your DigitalOcean API token. Needs read/write, and ALL scopes granted if you
# want it to double as the inference credential.
DIGITALOCEAN_ACCESS_TOKEN=

# Where App Platform pulls the code from.
GITHUB_REPO=hgonzalez-do/facility_issue_demo
GITHUB_BRANCH=main

# Name prefix for every resource deploy.sh creates. Also what destroy.sh
# matches on, and what you type to confirm a teardown.
STACK_NAME=complaints-dept

# Datacentre for the app and the database. Must support Managed Postgres:
#   doctl databases options regions --engine pg
DO_REGION=nyc3

# Sizes. These are the cheapest that comfortably run the demo.
#   basic-xxs        $5/mo   512MB   the web tier does almost nothing
#   db-s-1vcpu-1gb   $15/mo  1GB     smallest single-node Postgres
APP_SIZE=basic-xxs
DB_SIZE=db-s-1vcpu-1gb

# The closing beat: a cron trigger that writes the executive summary.
# Leave SUMMARY_CRON empty to skip it. Set it to a few minutes before your
# talk ends, in the timezone of the room.
#   SUMMARY_CRON=45 16 * * *
SUMMARY_CRON=
SUMMARY_TIMEZONE=America/New_York
